{
  "manifest_version": 3,
  "name": "Study Launcher",
  "description": "Mở trang học trước, web sau: khóa web theo trạng thái của Study Launcher.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Study Launcher",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": ["https://launcher.invalid/*"]
  }
}
