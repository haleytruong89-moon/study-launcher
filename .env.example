# Copy to .env.local for local work. Real values go ONLY into Vercel's environment variables.
# Never commit .env* files (except this one).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or the extension.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of this app, e.g. https://study-launcher.vercel.app
NEXT_PUBLIC_APP_URL=
# Domain used for the internal e-mail of child accounts (never receives mail). Optional.
CHILD_EMAIL_DOMAIN=study-launcher.local
# E-mail of the first parent account (the one created in Supabase > Authentication > Users). Required for first-run setup.
FIRST_PARENT_EMAIL=

# Used by later slices (S4+/S5): leave empty for S0.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
NEXT_PUBLIC_EXTENSION_ID_CHROME=
NEXT_PUBLIC_EXTENSION_ID_EDGE=
